{{! Unified Item List Section }}
<div class="items section">
  <div class="section-header">
    <h4 class="section-title">{{localize "tftloop.items"}}</h4>
    <button
      type="button"
      class="item-create"
      data-action="createItem"
      data-type="item"
    >
      <i class="fas fa-plus"></i>
    </button>
  </div>

  <ol class="info-list item-list">
    {{! Iconic Item FIRST }}
    <li class="iconic-item">
      <div class="iconic-item-label">
        {{localize "tftloop.iconic"}}
      </div>
      <div class="iconic-item-row">
        <input
          class="item-name"
          name="system.iconicItem.desc"
          type="text"
          value="{{model.iconicItem.desc}}"
        />
        <div class="item-bonus">
          <div class="item-bonus-content">{{model.iconicItem.bonus}}</div>
        </div>
        <div class="item-control">&nbsp;</div>
      </div>
    </li>

    {{! Regular Items AFTER }}
    {{#each bonusItems as |item id|}}
      <li class="info-item item" data-item-id="{{item._id}}" draggable="true">
        <input
          class="item-name inline-edit"
          data-field="name"
          type="text"
          value="{{item.name}}"
        />
        <div class="item-bonus">
          <input
            class="item-bonus-content inline-edit"
            data-field="system.bonus"
            type="text"
            value="{{item.system.bonus}}"
            data-dtype="Number"
          />
        </div>
        <div class="item-control">
          <a class="item-open" data-action="openItem">
            <i class="fas fa-edit"></i>
          </a>
          <a
            class="item-delete"
            data-action="deleteItem"
            data-type="item"
            data-trait="item"
            title="{{localize 'tftloop.delete'}}"
          >
            <i class="fas fa-minus"></i>
          </a>
        </div>
      </li>
    {{/each}}
  </ol>
</div>