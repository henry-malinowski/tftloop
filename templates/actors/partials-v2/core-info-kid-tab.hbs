{{! Kid Core Information Section }}
<div class="core-info">
  {{! Row 1: Type and Age (side-by-side, responsive) }}
  <div class="first-row">
    <div class="type-section">
      {{formGroup
        fields.type
        value=model.type
        choices=kidSet
        selected=selectedKidType
        localize=true
      }}
    </div>
    <div class="age-section">
      {{formGroup
        fields.age
        value=model.age
        choices=kidAgeSet
        selected=selectedAge
        localize=true
      }}
    </div>
  </div>

  {{! Row 2: Drive and Anchor (side-by-side, responsive) }}
  <div class="two-column-row">
    <div class="drive-section">
      {{formGroup fields.drive value=model.drive localize=true}}
    </div>
    <div class="anchor-section">
      {{formGroup fields.anchor value=model.anchor localize=true}}
    </div>
  </div>

  {{! Row 3: Problem (full-width) }}
  <div class="full-width-wrapper">
    {{formGroup fields.problem value=model.problem localize=true}}
  </div>

  {{! Row 4: Pride (full-width) }}
  <div class="full-width-wrapper">
    {{formGroup fields.pride value=model.pride localize=true}}
  </div>

  {{! Row 5: Description (full-width) }}
  <div class="full-width-wrapper">
    {{formGroup fields.description value=model.description localize=true}}
  </div>

  {{! Row 6: Favorite Song (full-width) }}
  <div class="full-width-wrapper">
    {{formGroup fields.favoriteSong value=model.favoriteSong localize=true}}
  </div>

  {{! Row 7: Hideout (full-width) - Migrated from hideout tab }}
  <div class="full-width-wrapper hideout-section">
    <label class="field-label">{{localize "tftloop.hideout"}}</label>
    <textarea
      name="system.hideout"
      rows="4"
      placeholder="{{localize 'tftloop.hideout'}}"
    >{{model.hideout}}</textarea>
  </div>
</div>