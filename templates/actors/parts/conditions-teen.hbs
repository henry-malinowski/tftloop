<div class="conditions-scars flexrow">
	<div class="conditions conditions-v1 flexcol">
		<div class="section-header">
			<h4 class="section-title">{{localize "tftloop.conditions"}}</h4>
		</div>

		{{> "systems/tftloop/templates/actors/parts/conditions-list-v1.hbs" layout="column" brokenKey="tftflood.broken"}}
	</div>

	<div class="scars flexcol info-group">
		<div class="section-header flexrow">
			<h4 class="section-title">{{localize "tftflood.scars"}}</h4>
			<p class="col-head">{{localize "tftflood.accepted"}}</p>

			<div class="item-control">
				<a class="item-control item-create" data-type="scar" data-trait="scar" title="{{localize 'tftflood.newScar'}}">
					<i class="fas fa-plus"></i>
				</a>
			</div>
		</div>

		<ol class="info-list">
			{{#each scars as |scar id|}}
			<li class="info-item flexrow item" data-item-id="{{scar._id}}" draggable="true">
				<input class="scar-name inline-edit" data-field="name" type="text" value="{{name}}" />
				<input class="scar-desc inline-edit" data-field="system.description" type="text"
					value="{{scar.system.description}}" />

				{{checkboxToggle scar.system.accepted "accepted"}}

				<div class="item-control">
					<a class="item-open">
						<i class="fas fa-edit"></i>
					</a>

					<a class="item-delete" data-type="scar" data-trait="scar" title="{{localize 'tftloop.delete'}}">
						<i class="fas fa-minus"></i>
					</a>
				</div>
			</li>
			{{/each}}
		</ol>
	</div>
</div>