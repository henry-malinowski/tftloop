<form class="actor-sheet {{cssClass}}" autocomplete="off">
    <header class="teen-header">
        <img src="systems/tftloop/img/flood/tftflood_sheet_logo.png" class="logo" title="tales from the loop logo">
    </header>

    <div class="flexrow">
        <div class="sidebar flexcol">
            <div class="name-box">
                <h1 class="charname">
                    <input name="name" type="text" value="{{actor.name}}" placeholder="name"/>
                </h1>

                <div class="portrait">
                    <img src="{{actor.img}}" data-edit="img" title="{{actor.name}}" height="160"  width="160"/>
                </div>

                <div class="type">
                    <label>{{localize "tftloop.type"}}</label>
                    
                    <select name="system.type">
                        {{selectOptions teenSet selected=selectedTeenType localize=true}} 
                    </select>

                </div>  
            </div>

            <div class="attributes-skills">
                <div class="section-header">
                    <h4 class="section-title">{{localize "tftloop.attributesSkills"}}</h4>
                </div>
                <ol class="attribute-list">
                    <li class="attribute flexrow body" >
                        <span class="roll-control" data-action="rollAttribute" data-attr="body">{{localize "tftloop.body"}}</span>
                        <input type="text" name="system.attributes.body" value="{{data.system.attributes.body}}" data-dtype="Number"/>
                    </li>
                    <li>
                        <ol class="skill-list">
                            <li class="skill flexrow sneak">
                                <span class="roll-control" data-action="rollSkill" data-attr="body" data-skill="sneak">{{localize "tftloop.sneak"}}</span>
                                <input type="text" name="system.skills.body.sneak" value="{{data.system.skills.body.sneak}}" data-dtype="Number"/>
                            </li>
                            <li class="skill flexrow force">
                                <span class="roll-control" data-action="rollSkill" data-attr="body" data-skill="force">{{localize "tftloop.force"}}</span>
                                <input type="text" name="system.skills.body.force" value="{{data.system.skills.body.force}}" data-dtype="Number"/>
                            </li>
                            <li class="skill flexrow move">
                                <span class="roll-control" data-action="rollSkill" data-attr="body" data-skill="move">{{localize "tftloop.move"}}</span>
                                <input type="text" name="system.skills.body.move" value="{{data.system.skills.body.move}}" data-dtype="Number"/>
                            </li>
                        </ol>
                    </li>
                    <li class="attribute flexrow tech">
                        <span class="roll-control" data-action="rollAttribute" data-attr="tech">{{localize "tftloop.tech"}}</span>
                        <input type="text" name="system.attributes.tech" value="{{data.system.attributes.tech}}" data-dtype="Number"/>
                    </li>
                    <li>
                        <ol class="skill-list">
                            <li class="skill flexrow tinker">
                                <span class="roll-control" data-action="rollSkill" data-attr="tech" data-skill="tinker">{{localize "tftloop.tinker"}}</span>
                                <input type="text" name="system.skills.tech.tinker" value="{{data.system.skills.tech.tinker}}" data-dtype="Number"/>
                            </li>
                            <li class="skill flexrow program">
                                <span class="roll-control" data-action="rollSkill" data-attr="tech" data-skill="program">{{localize "tftloop.program"}}</span>
                                <input type="text" name="system.skills.tech.program" value="{{data.system.skills.tech.program}}" data-dtype="Number"/>
                            </li>
                            <li class="skill flexrow calculate">
                                <span class="roll-control" data-action="rollSkill" data-attr="tech" data-skill="calculate">{{localize "tftloop.calculate"}}</span>
                                <input type="text" name="system.skills.tech.calculate" value="{{data.system.skills.tech.calculate}}" data-dtype="Number"/>
                            </li>
                        </ol>
                    </li>
                    <li class="attribute flexrow heart">
                        <span class="roll-control" data-action="rollAttribute" data-attr="heart">{{localize "tftloop.heart"}}</span>
                        <input type="text" name="system.attributes.heart" value="{{data.system.attributes.heart}}" data-dtype="Number"/>
                    </li>
                    <li>
                        <ol class="skill-list">
                            <li class="skill flexrow contact">
                                <span class="roll-control" data-action="rollSkill" data-attr="heart" data-skill="contact">{{localize "tftloop.contact"}}</span>
                                <input type="text" name="system.skills.heart.contact" value="{{data.system.skills.heart.contact}}" data-dtype="Number"/>
                            </li>
                            <li class="skill flexrow charm">
                                <span class="roll-control" data-action="rollSkill" data-attr="heart" data-skill="charm">{{localize "tftloop.charm"}}</span>
                                <input type="text" name="system.skills.heart.charm" value="{{data.system.skills.heart.charm}}" data-dtype="Number"/>
                            </li>
                            <li class="skill flexrow lead">
                                <span class="roll-control" data-action="rollSkill" data-attr="heart" data-skill="lead">{{localize "tftloop.lead"}}</span>
                                <input type="text" name="system.skills.heart.lead" value="{{data.system.skills.heart.lead}}" data-dtype="Number"/>
                            </li>
                        </ol>
                    </li>
                    <li class="attribute flexrow mind">
                        <span class="roll-control" data-action="rollAttribute" data-attr="mind">{{localize "tftloop.mind"}}</span>
                        <input type="text" name="system.attributes.mind" value="{{data.system.attributes.mind}}" data-dtype="Number"/>
                    </li>
                    <li>
                        <ol class="skill-list">
                            <li class="skill flexrow investigate">
                                <span class="roll-control" data-action="rollSkill" data-attr="mind" data-skill="investigate">{{localize "tftloop.investigate"}}</span>
                                <input type="text" name="system.skills.mind.investigate" value="{{data.system.skills.mind.investigate}}" data-dtype="Number"/>
                            </li>
                            <li class="skill flexrow comprehend">
                                <span class="roll-control" data-action="rollSkill" data-attr="mind" data-skill="comprehend">{{localize "tftloop.comprehend"}}</span>
                                <input type="text" name="system.skills.mind.comprehend" value="{{data.system.skills.mind.comprehend}}" data-dtype="Number"/>
                            </li>
                            <li class="skill flexrow empathize">
                                <span class="roll-control" data-action="rollSkill" data-attr="mind" data-skill="empathize">{{localize "tftloop.empathize"}}</span>
                                <input type="text" name="system.skills.mind.empathize" value="{{data.system.skills.mind.empathize}}" data-dtype="Number"/>
                            </li>
                        </ol>
                    </li>
                </ol>
            </div>

            <div class="experience-group">
                <div class="section-header experience">
                    <h4 class="section-title">{{localize "tftloop.experience"}}</h4>
                </div>

                <div class="exp-boxes flexrow" title="{{localize "tftloop.addexp"}}">
                    {{#times 10}}
                    <div class="exp-box">
                        <div class="img-container">
                            {{#if (gte ../data.system.exp @index)}}
                            <img src="systems/tftloop/img/box_checked.png" height="18px" width="18px">
                            {{/if}}
                            {{#unless (gte ../data.system.exp @index)}}
                            <img src="systems/tftloop/img/box_not_checked.png" height="18px" width="18px">
                            {{/unless}}
                        </div>
                    </div>
                    {{/times}}
                </div>
            </div>
        </div>

        <div class="flexcol">
            <div class="sheet-tabs tabs flexrow" data-group="primary">
                    <b class="item" data-tab="main">{{localize "tftloop.main"}}</b>
                    <b class="item" data-tab="note">{{localize "tftloop.notes"}}</b>
            </div>
            <div class="sheet-body">
                <div class="tab" data-group="primary" data-tab="main">
                    <div class="main flexcol">
                        {{> "systems/tftloop/templates/actors/parts/core-teen.hbs"}}
                        {{> "systems/tftloop/templates/actors/parts/teen-item-notes.hbs"}} 
                        {{> "systems/tftloop/templates/actors/parts/relationships-teen.hbs"}}
                        {{> "systems/tftloop/templates/actors/parts/conditions-teen.hbs"}}
                    </div>
                </div>
                <div class="tab" data-group="primary" data-tab="note">
                    <div class="notes-group info-group">
                        <h4 class="section-title">{{localize "tftloop.notes"}}</h4>
                        <div class="kid-notes">
                            {{editor data.system.notes.value target="system.notes.value" button=true owner=owner editable=true engine="prosemirror" }}
                        </div>
                    </div>
                </div>
            </div>
       </div>
   
   
    </div>

    <footer class="sheet-footer">
        <img src="systems/tftloop/img/flood/sheet-footer.jpg" class="logo" title="page footer image">
    </footer>
</form>
